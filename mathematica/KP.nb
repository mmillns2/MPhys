Cell["\<\
8*((m1*ma - Pair(Momentum(p1),Momentum(q1)))*Pair(Momentum(q),Momentum(q)) + \
2*Pair(Momentum(p1),Momentum(q2))*Pair(Momentum(q),Momentum(q1)) + 
     2*m1*ma*Pair(Momentum(q),Momentum(q2)) - \
2*Pair(Momentum(p1),Momentum(q1))*Pair(Momentum(q),Momentum(q2)) + 
     2*Pair(Momentum(p1),Momentum(q2))*Pair(Momentum(q1),Momentum(q2)) + 
     2*Pair(Momentum(p1),Momentum(q))*(Pair(Momentum(q),Momentum(q1)) + \
Pair(Momentum(q1),Momentum(q2))) + m1*ma*Pair(Momentum(q2),Momentum(q2)) - 
     Pair(Momentum(p1),Momentum(q1))*Pair(Momentum(q2),Momentum(q2)))*
   (Pair(Momentum(p2),Momentum(p2))*(Pair(Momentum(p2),Momentum(q3)) - \
2*Pair(Momentum(q3),Momentum(q3))) + 
     Pair(Momentum(p2),Momentum(q3))*Pair(Momentum(q3),Momentum(q3)))\
\>", "Output",
