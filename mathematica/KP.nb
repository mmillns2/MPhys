   3.949640234255086*^9},ExpressionUUID->"8785c899-0a14-44df-b69c-\
3862388500c7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\n", 
  RowBox[{"expr", "/.", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"Momentum", "[", "p1", "]"}], ":>", 
      RowBox[{"Momentum", "[", 
       RowBox[{
       "s", ",", "p1", ",", "W", ",", "theta", ",", "thetaStar", ",", 
        "phiStar"}], "]"}]}], ",", 
     RowBox[{
      RowBox[{"Momentum", "[", "p2", "]"}], ":>", 
      RowBox[{"Momentum", "[", 
       RowBox[{
       "s", ",", "p2", ",", "W", ",", "theta", ",", "thetaStar", ",", 
