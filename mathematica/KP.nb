      RowBox[{"Momentum", "[", "q2", "]"}], ":>", 
      RowBox[{"Momentum", "[", 
       RowBox[{
       "s", ",", "q2", ",", "W", ",", "theta", ",", "thetaStar", ",", 
        "phiStar"}], "]"}]}], ",", 
     RowBox[{
      RowBox[{"Momentum", "[", "q", "]"}], ":>", 
      RowBox[{"Momentum", "[", 
       RowBox[{
       "s", ",", "q", ",", "W", ",", "theta", ",", "thetaStar", ",", 
        "phiStar"}], "]"}]}]}], "}"}]}]}]], "Input",
