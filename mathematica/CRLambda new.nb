        TraditionalForm], 
       FormBox[
        FormBox["\[Nu]",
         TraditionalForm],
        TraditionalForm]]}], "+", 
     RowBox[{"8", " ", "\[ImaginaryI]", " ", 
      SuperscriptBox[
       OverscriptBox["\[Epsilon]", "_"], 
       RowBox[{
        FormBox[
         FormBox["\[Mu]",
          TraditionalForm],
         TraditionalForm], 
        FormBox[
