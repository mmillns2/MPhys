          TraditionalForm], 
         FormBox[
          OverscriptBox[
           FormBox["q3",
            TraditionalForm], "_"],
          TraditionalForm]}], ")"}]}]}], "+", 
     RowBox[{"8", " ", 
      SuperscriptBox[
       FormBox[
        OverscriptBox[
         FormBox["p2",
