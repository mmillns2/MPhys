Cell[BoxData[
 RowBox[{"\n", 
  RowBox[{"expr", "/.", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"Momentum", "[", "p1", "]"}], ":>", 
      RowBox[{"Momentum", "[", 
       RowBox[{
       "p1", ",", "ma", ",", "m1", ",", "m2", ",", "m3", ",", "s", ",", "W", 
        ",", "theta", ",", "thetaStar", ",", "phiStar"}], "]"}]}], ",", 
     RowBox[{
      RowBox[{"Momentum", "[", "p2", "]"}], ":>", 
      RowBox[{"Momentum", "[", 
       RowBox[{
       "p2", ",", "ma", ",", "m1", ",", "m2", ",", "m3", ",", "s", ",", "W", 
        ",", "theta", ",", "thetaStar", ",", "phiStar"}], "]"}]}], ",", 
     RowBox[{
      RowBox[{"Momentum", "[", "q1", "]"}], ":>", 
      RowBox[{"Momentum", "[", 
       RowBox[{
       "q1", ",", "ma", ",", "m1", ",", "m2", ",", "m3", ",", "s", ",", "W", 
        ",", "theta", ",", "thetaStar", ",", "phiStar"}], "]"}]}], ",", 
     RowBox[{
      RowBox[{"Momentum", "[", "q3", "]"}], ":>", 
