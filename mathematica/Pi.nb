Cell["\<\
(8*Power(APi,2)*Power(D + F,2)*Power(ma,2)*Power(Vus,2)*(m1*ma - \
Pair(Momentum(p1),Momentum(q1)))*
     (Pair(Momentum(p2),Momentum(q3))*(-4*Pair(Momentum(q2),Momentum(q2)) + \
Pair(Momentum(q3),Momentum(q3))) + 
       4*Pair(Momentum(p2),Momentum(q2))*(2*Pair(Momentum(q2),Momentum(q3)) + \
Pair(Momentum(q3),Momentum(q3))) + 
       Pair(Momentum(p2),Momentum(p2))*(Pair(Momentum(p2),Momentum(q3)) - \
2*(2*Pair(Momentum(q2),Momentum(q3)) + Pair(Momentum(q3),Momentum(q3))))))/
   (Power(fPi,2)*Power(mPi + q - q2,2)*Power(mPi - q + q2,2))\
\>", "Output",
 CellChangeTimes->{{3.949476083841793*^9, 3.949476090132435*^9}, 
