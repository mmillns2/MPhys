Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Define", " ", "a", " ", "symbolic", " ", "momentum", " ", "function", " ",
     "that", " ", "behaves", " ", "like", " ", "Momentum", 
    RowBox[{"(", 
     RowBox[{"p", ",", "a", ",", "b", ",", "c", ",", "d"}], ")"}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"Momentum", "[", 
     RowBox[{"p_", ",", "a_", ",", "b_", ",", "c_", ",", "d_"}], "]"}], ":=", 
    
    RowBox[{
     RowBox[{"HoldForm", "[", "Momentum", "]"}], "[", 
     RowBox[{"p", ",", "a", ",", "b", ",", "c", ",", "d"}], "]"}]}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Define", " ", "four"}], "-", 
     RowBox[{"momenta", " ", "using", " ", "Momentum", " ", "function"}]}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"pMu", "[", 
     RowBox[{"a_", ",", "b_", ",", "c_", ",", "d_"}], "]"}], ":=", 
    RowBox[{"Momentum", "[", 
     RowBox[{"p", ",", "a", ",", "b", ",", "c", ",", "d"}], "]"}]}], "\n", 
   RowBox[{
    RowBox[{"qMu", "[", 
     RowBox[{"a_", ",", "b_", ",", "c_", ",", "d_"}], "]"}], ":=", 
    RowBox[{"Momentum", "[", 
     RowBox[{"q", ",", "a", ",", "b", ",", "c", ",", "d"}], "]"}]}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Example", " ", "expression", " ", "using", " ", "pMu", " ", "and", " ", 
     "qMu"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"M", "=", 
     RowBox[{
      RowBox[{"pMu", "[", 
       RowBox[{"a", ",", "b", ",", "c", ",", "d"}], "]"}], "+", 
      RowBox[{"qMu", "[", 
       RowBox[{"a", ",", "b", ",", "c", ",", "d"}], "]"}]}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Convert", " ", "to", " ", "C", " ", "code"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"CForm", "[", "M", "]"}]}]}]], "Input",
 CellChangeTimes->{{3.9494784270866833`*^9, 3.94947842709269*^9}},
 CellLabel->
  "In[414]:=",ExpressionUUID->"8d1df73e-ac88-427d-80c5-a955177271e1"],

Cell["Momentum(p,a,b,c,d) + Momentum(q,a,b,c,d)", "Output",
 CellChangeTimes->{
  3.949478431274705*^9, {3.9494850194405413`*^9, 3.9494850377005577`*^9}},
 CellLabel->
  "Out[418]//CForm=",ExpressionUUID->"0cf8115d-6894-460b-9f39-84cddd5253e9"]
}, Open  ]]
