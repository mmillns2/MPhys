Cell["\<\
(Power(ACRSigma,2)*Power(D - F,2)*Power(Vus,2)*((-32*Power(D - F,2)*
          (2*Power(mSigma,2)*Pair(Momentum(p1),Momentum(q3))*Pair(Momentum(p2)\
,Momentum(q2))*Pair(Momentum(q1),Momentum(q2)) - 
            2*Pair(Momentum(p1),Momentum(p1))*Pair(Momentum(p1),Momentum(q3))*\
Pair(Momentum(p2),Momentum(q2))*Pair(Momentum(q1),Momentum(q2)) - 
            4*Pair(Momentum(p1),Momentum(q))*Pair(Momentum(p1),Momentum(q3))*\
Pair(Momentum(p2),Momentum(q2))*Pair(Momentum(q1),Momentum(q2)) + 
            4*Pair(Momentum(p1),Momentum(q2))*(Pair(Momentum(p1),Momentum(q3))\
*Pair(Momentum(p2),Momentum(q)) + ma*mSigma*Pair(Momentum(p2),Momentum(q3)))*
             Pair(Momentum(q1),Momentum(q2)) - \
2*Pair(Momentum(p1),Momentum(q3))*Pair(Momentum(p2),Momentum(q2))*Pair(\
Momentum(q),Momentum(q))*
             Pair(Momentum(q1),Momentum(q2)) + \
4*Pair(Momentum(p1),Momentum(q3))*Pair(Momentum(p2),Momentum(q))*Pair(\
Momentum(q),Momentum(q2))*
             Pair(Momentum(q1),Momentum(q2)) + \
4*ma*mSigma*Pair(Momentum(p2),Momentum(q3))*Pair(Momentum(q),Momentum(q2))*\
Pair(Momentum(q1),Momentum(q2)) - 
            2*m1*mSigma*Pair(Momentum(p1),Momentum(q3))*Pair(Momentum(p2),\
