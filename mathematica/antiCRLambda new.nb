       FormBox[
        OverscriptBox[
         FormBox["q3",
          TraditionalForm], "_"],
        TraditionalForm], 
       FormBox[
        FormBox["\[Nu]",
         TraditionalForm],
        TraditionalForm]]}], "-", 
     RowBox[{"8", " ", "\[ImaginaryI]", " ", 
      SuperscriptBox[
       OverscriptBox["\[Epsilon]", "_"], 
       RowBox[{
        FormBox[
         FormBox["\[Mu]",
          TraditionalForm],
         TraditionalForm], 
        FormBox[
         FormBox["\[Nu]",
          TraditionalForm],
         TraditionalForm], 
        FormBox[
         OverscriptBox[
          FormBox["p2",
           TraditionalForm], "_"],
