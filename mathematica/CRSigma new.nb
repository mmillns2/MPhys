Cell[CellGroupData[{

Cell["Compute the tensor", "Subsection",
 CellChangeTimes->{{3.949585765494211*^9, 
  3.9495857869214993`*^9}},ExpressionUUID->"92d1b372-1dcc-4e7e-9721-\
c038ac1d40f3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"LeptonicTensor", " ", "=", " ", 
  RowBox[{
   FractionBox["1", "2"], 
   RowBox[{"DiracSimplify", "[", 
    RowBox[{"DiracTrace", "[", 
     RowBox[{
     "Completenessq3", ".", "LeptonicVertex", ".", "Completenessp2", ".", 
      "ConjugateLeptonicVertex"}], "]"}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.947909852668064*^9, 3.947909857257827*^9}, {
  3.9479099133179293`*^9, 3.947909918849585*^9}, {3.9482707966330547`*^9, 
