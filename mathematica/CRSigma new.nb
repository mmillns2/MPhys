              (Pair(Momentum(p2,vects),Momentum(q3,vects)) - \
Pair(Momentum(q3,vects),Momentum(q3,vects))) + 
             Pair(Momentum(q2,vects),Momentum(q2,vects))*(2*m1*Pair(Momentum(\
