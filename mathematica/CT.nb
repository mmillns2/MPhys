Cell["\<\
(16*Power(ACT,2)*Power(GF,2)*Power(Vus,2)*Pair(Momentum(p1),Momentum(q3))*\
Pair(Momentum(p2),Momentum(q1)))/Power(fPi,2) + 
   (32*Power(ACT,2)*BCT*Power(GF,2)*Power(Vus,2)*Pair(Momentum(p1),Momentum(\
q3))*Pair(Momentum(p2),Momentum(q1)))/Power(fPi,2) + 
   (16*Power(ACT,2)*Power(BCT,2)*Power(GF,2)*Power(Vus,2)*Pair(Momentum(p1),\
Momentum(q3))*Pair(Momentum(p2),Momentum(q1)))/Power(fPi,2) - 
   (16*Power(ACT,2)*Power(GF,2)*m1*ma*Power(Vus,2)*Pair(Momentum(p2),Momentum(\
q3)))/Power(fPi,2) + 
   (16*Power(ACT,2)*Power(BCT,2)*Power(GF,2)*m1*ma*Power(Vus,2)*Pair(Momentum(\
p2),Momentum(q3)))/Power(fPi,2) + 
   (16*Power(ACT,2)*Power(GF,2)*Power(Vus,2)*Pair(Momentum(p1),Momentum(p2))*\
Pair(Momentum(q1),Momentum(q3)))/Power(fPi,2) - 
   (32*Power(ACT,2)*BCT*Power(GF,2)*Power(Vus,2)*Pair(Momentum(p1),Momentum(\
p2))*Pair(Momentum(q1),Momentum(q3)))/Power(fPi,2) + 
   (16*Power(ACT,2)*Power(BCT,2)*Power(GF,2)*Power(Vus,2)*Pair(Momentum(p1),\
Momentum(p2))*Pair(Momentum(q1),Momentum(q3)))/Power(fPi,2)\
\>", "Output",
