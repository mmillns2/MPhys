m2,m3,s,W,theta,thetaStar,phiStar)))*
                      Pair(Momentum(q1,ma,m1,m2,m3,s,W,theta,thetaStar,\
phiStar),Momentum(q3,ma,m1,m2,m3,s,W,theta,thetaStar,phiStar)) + 
                     2*Pair(Momentum(q2),Momentum(q2))*Pair(Momentum(p1,ma,m1,\
m2,m3,s,W,theta,thetaStar,phiStar),
                       Momentum(q3,ma,m1,m2,m3,s,W,theta,thetaStar,phiStar))*
                      Pair(Momentum(q1,ma,m1,m2,m3,s,W,theta,thetaStar,\
phiStar),Momentum(q3,ma,m1,m2,m3,s,W,theta,thetaStar,phiStar)) + 
                     (Pair(Momentum(q2),Momentum(q1,ma,m1,m2,m3,s,W,theta,\
thetaStar,phiStar))*
                         (Power(mSigma,2) - \
Pair(Momentum(p1,ma,m1,m2,m3,s,W,theta,thetaStar,phiStar),Momentum(p1,ma,m1,\
m2,m3,s,W,theta,thetaStar,phiStar))) + 
                        Pair(Momentum(q2),Momentum(q2))*(m1*ma - m1*mSigma - 
                           2*Pair(Momentum(p1,ma,m1,m2,m3,s,W,theta,thetaStar,\
phiStar),Momentum(q1,ma,m1,m2,m3,s,W,theta,thetaStar,phiStar))))*
                      Pair(Momentum(q3,ma,m1,m2,m3,s,W,theta,thetaStar,\
phiStar),Momentum(q3,ma,m1,m2,m3,s,W,theta,thetaStar,phiStar)))))))/
        (Power(ma,2)*Power(mSigma + p1 - q2,2)*Power(mSigma - p1 + \
q2,2))))/(2.*Power(fPi,2))\
\>", "Output",
