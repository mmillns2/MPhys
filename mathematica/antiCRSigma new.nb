c038ac1d40f3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"LeptonicTensor", " ", "=", " ", 
  RowBox[{
   FractionBox["1", "2"], 
   RowBox[{"DiracSimplify", "[", 
    RowBox[{"DiracTrace", "[", 
     RowBox[{
     "Completenessq3", ".", "LeptonicVertex", ".", "Completenessp2", ".", 
      "ConjugateLeptonicVertex"}], "]"}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.947909852668064*^9, 3.947909857257827*^9}, {
