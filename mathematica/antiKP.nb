Cell["Define function expressions to fit our needs", "Subsubsection",
 CellChangeTimes->{{3.949639295802826*^9, 3.9496393279197206`*^9}, 
   3.949640234255086*^9},ExpressionUUID->"8785c899-0a14-44df-b69c-\
3862388500c7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\n", 
  RowBox[{"expr", "/.", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"Momentum", "[", "p1", "]"}], ":>", 
      RowBox[{"Momentum", "[", 
       RowBox[{
       "s", ",", "p1", ",", "W", ",", "theta", ",", "thetaStar", ",", 
        "phiStar"}], "]"}]}], ",", 
     RowBox[{
      RowBox[{"Momentum", "[", "p2", "]"}], ":>", 
      RowBox[{"Momentum", "[", 
       RowBox[{
       "s", ",", "p2", ",", "W", ",", "theta", ",", "thetaStar", ",", 
        "phiStar"}], "]"}]}], ",", 
     RowBox[{
      RowBox[{"Momentum", "[", "q1", "]"}], ":>", 
      RowBox[{"Momentum", "[", 
       RowBox[{
       "s", ",", "q1", ",", "W", ",", "theta", ",", "thetaStar", ",", 
        "phiStar"}], "]"}]}], ",", 
     RowBox[{
      RowBox[{"Momentum", "[", "q3", "]"}], ":>", 
      RowBox[{"Momentum", "[", 
       RowBox[{
       "s", ",", "q3", ",", "W", ",", "theta", ",", "thetaStar", ",", 
        "phiStar"}], "]"}]}], ",", 
     RowBox[{
      RowBox[{"Momentum", "[", "q2", "]"}], ":>", 
      RowBox[{"Momentum", "[", 
       RowBox[{
       "s", ",", "q2", ",", "W", ",", "theta", ",", "thetaStar", ",", 
        "phiStar"}], "]"}]}], ",", 
     RowBox[{
      RowBox[{"Momentum", "[", "q", "]"}], ":>", 
      RowBox[{"Momentum", "[", 
       RowBox[{
       "s", ",", "q", ",", "W", ",", "theta", ",", "thetaStar", ",", 
        "phiStar"}], "]"}]}]}], "}"}]}]}]], "Input",
