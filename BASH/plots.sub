executable      = apptainer_run_plots.sh
request_memory  = 16G
request_cpus    = 2
request_gpus    = 0
request_disk    = 20G
initialdir      = $ENV(HOME)/scripts
output          = out/plots/plots.out
error           = out/plots/plots.err
log             = out/plots/plots.log
arguments       = $(Process)
should_transfer_files = yes
when_to_transfer_output = ON_EXIT
queue 1
